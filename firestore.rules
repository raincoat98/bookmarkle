rules_version = '2';
service cloud.firestore {

  function signedIn() {
    return request.auth != null;
  }

  // 커스텀 클레임 OR admins 컬렉션 양쪽 확인
  // (앱이 admins 컬렉션 기반으로 관리자 체크하므로 두 방식 모두 지원)
  function isAdmin() {
    return signedIn() && (
      request.auth.token.isAdmin == true ||
      exists(/databases/$(database)/documents/admins/$(request.auth.uid))
    );
  }

  function isOwner(userId) {
    return signedIn() && request.auth.uid == userId;
  }

  // 쓰기 요청에서 userId가 자신의 uid인지 확인
  function isWritingOwnData() {
    return signedIn() && request.resource.data.userId == request.auth.uid;
  }

  // 기존 문서의 소유자인지 확인
  function isDocOwner() {
    return signedIn() && resource.data.userId == request.auth.uid;
  }

  match /databases/{database}/documents {

    // ─── admins 컬렉션 ────────────────────────────────────────────────
    // 읽기: 인증된 사용자 (관리자 여부 확인용)
    // 쓰기: 기존 관리자만
    match /admins/{adminId} {
      allow read:  if signedIn();
      allow write: if isAdmin();
    }

    // ─── 전역 설정 (config 컬렉션) ────────────────────────────────────
    // config/featureFlags: 베타/구독 기능 플래그 (모두 읽기, 관리자만 쓰기)
    match /config/{configId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ─── 북마크 (최상위 flat collection) ──────────────────────────────
    // list: 인증 필수 (클라이언트는 반드시 where('userId','==',uid) 쿼리 사용)
    // get/write/delete: 소유자 또는 관리자만
    match /bookmarks/{bookmarkId} {
      allow list:   if isAdmin() || signedIn();
      allow get:    if isAdmin() || isDocOwner();
      allow create: if isAdmin() || isWritingOwnData();
      allow update: if isAdmin() || isDocOwner();
      allow delete: if isAdmin() || isDocOwner();
    }

    // ─── 컬렉션 (최상위 flat collection) ──────────────────────────────
    match /collections/{collectionId} {
      allow list:   if isAdmin() || signedIn();
      allow get:    if isAdmin() || isDocOwner();
      allow create: if isAdmin() || isWritingOwnData();
      allow update: if isAdmin() || isDocOwner();
      allow delete: if isAdmin() || isDocOwner();
    }

    // ─── 알림 (최상위 flat collection) ────────────────────────────────
    match /notifications/{notificationId} {
      allow list:   if isAdmin() || signedIn();
      allow get:    if isAdmin() || isDocOwner();
      allow create: if isAdmin() || isWritingOwnData();
      allow update: if isAdmin() || isDocOwner();
      allow delete: if isAdmin() || isDocOwner();
    }

    // ─── 사용자 문서 ──────────────────────────────────────────────────
    match /users/{userId} {
      // list: 관리자만 (관리자 페이지 전체 사용자 조회)
      allow list:   if isAdmin();
      // get/write: 본인 또는 관리자
      allow get:    if isAdmin() || isOwner(userId);
      allow create: if isAdmin() || isOwner(userId);
      allow update: if isAdmin() || isOwner(userId);
      allow delete: if isAdmin();

      // 설정 하위 컬렉션 (날씨 위치, 알림 설정, 기본 페이지 등)
      match /settings/{docId} {
        allow read, write: if isAdmin() || isOwner(userId);
      }

      // 백업 하위 컬렉션
      match /backups/{backupId} {
        allow read:   if isAdmin() || isOwner(userId);
        allow create: if isAdmin() || isOwner(userId);
        allow update: if isAdmin() || isOwner(userId);
        allow delete: if isAdmin() || isOwner(userId);
      }

      // 북마크 하위 컬렉션 (향후 마이그레이션 대비)
      match /bookmarks/{bookmarkId} {
        allow read, write, delete: if isAdmin() || isOwner(userId);
      }

      // 컬렉션 하위 컬렉션 (향후 마이그레이션 대비)
      match /collections/{collectionId} {
        allow read, write, delete: if isAdmin() || isOwner(userId);
      }
    }

    // ─── 기본: 모든 접근 거부 ─────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
